--[[!
@fqxn Dox.DoxCSharp
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxCSharp : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("cs"),
            };
        }

        public DoxCSharp(sTitle) {
            base("DoxCSharp", sTitle, "!", "!", "@", Dox.SYNTAX.C_SHARP,
                DoxCSharp.createMimeTypes(sTitle));
        }
    }
}
