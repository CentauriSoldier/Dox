--[[!
@fqxn Dox.DoxPython
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxPython : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("py"),
            };
        }

        public DoxPython(sTitle) {
            base("DoxPython", sTitle, "!", "!", "@", Dox.SYNTAX.PYTHON,
                DoxPython.createMimeTypes(sTitle));
        }
    }
}
