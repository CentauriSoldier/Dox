--[[!
@fqxn Dox.DoxGroovy
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxGroovy : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("groovy"),
            };
        }

        public DoxGroovy(sTitle) {
            base("DoxGroovy", sTitle, "!", "!", "@", Dox.SYNTAX.GROOVY,
                DoxGroovy.createMimeTypes(sTitle));
        }
    }
}
