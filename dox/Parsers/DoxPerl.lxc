--[[!
@fqxn Dox.DoxPerl
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxPerl : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("pl"),
                Dox.DoxMime("pm"),
            };
        }

        public DoxPerl(sTitle) {
            base("DoxPerl", sTitle, "!", "!", "@", Dox.SYNTAX.PERL,
                DoxPerl.createMimeTypes(sTitle));
        }
    }
}
