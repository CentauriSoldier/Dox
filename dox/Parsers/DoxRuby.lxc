--[[!
@fqxn Dox.DoxRuby
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxRuby : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("rb"),
            };
        }

        public DoxRuby(sTitle) {
            base("DoxRuby", sTitle, "!", "!", "@", Dox.SYNTAX.RUBY,
                DoxRuby.createMimeTypes(sTitle));
        }
    }
}
