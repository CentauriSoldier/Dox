--[[!
@fqxn Dox.DoxJavaScript
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxJavaScript : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("js"),
            };
        }

        public DoxJavaScript(sTitle) {
            base("DoxJavaScript", sTitle, "!", "!", "@", Dox.SYNTAX.JAVASCRIPT,
                DoxJavaScript.createMimeTypes(sTitle));
        }
    }
}
