--[[!
@fqxn Dox.DoxMatlab
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxMatlab : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("matlab"),
            };
        }

        public DoxMatlab(sTitle) {
            base("DoxMatlab", sTitle, "!", "!", "@", Dox.SYNTAX.MATLAB,
                DoxMatlab.createMimeTypes(sTitle));
        }
    }
}
