--[[!
@fqxn Dox.DoxJulia
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxJulia : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("jl"),
            };
        }

        public DoxJulia(sTitle) {
            base("DoxJulia", sTitle, "!", "!", "@", Dox.SYNTAX.JULIA,
                DoxJulia.createMimeTypes(sTitle));
        }
    }
}
