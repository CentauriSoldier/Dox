--[[!
@fqxn Dox.DoxCPlusPlus
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxCPlusPlus : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("cpp"),
                Dox.DoxMime("cxx"),
            };
        }

        public DoxCPlusPlus(sTitle) {
            base("DoxCPlusPlus", sTitle, "!", "!", "@", Dox.SYNTAX.C_PLUS_PLUS,
                DoxCPlusPlus.createMimeTypes(sTitle));
        }
    }
}
