--[[!
@fqxn Dox.DoxAssemblyNasm
@desc NASM assembly documentation parser retaining the asm MIME and existing delimiters.
!]]
namespace Dox {
    final class DoxAssemblyNasm : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("asm"),
            };
        }

        public DoxAssemblyNasm(sTitle) {
            base("DoxAssemblyNasm", sTitle, "!", "!", "@", Dox.SYNTAX.ASSEMBLY_NASM,
                DoxAssemblyNasm.createMimeTypes(sTitle));
        }
    }
}
