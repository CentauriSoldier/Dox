--[[!
@fqxn Dox.DoxTypeScript
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxTypeScript : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("ts"),
            };
        }

        public DoxTypeScript(sTitle) {
            base("DoxTypeScript", sTitle, "!", "!", "@", Dox.SYNTAX.TYPESCRIPT,
                DoxTypeScript.createMimeTypes(sTitle));
        }
    }
}
