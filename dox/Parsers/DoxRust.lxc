--[[!
@fqxn Dox.DoxRust
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxRust : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("rs"),
            };
        }

        public DoxRust(sTitle) {
            base("DoxRust", sTitle, "!", "!", "@", Dox.SYNTAX.RUST,
                DoxRust.createMimeTypes(sTitle));
        }
    }
}
