--[[!
@fqxn Dox.DoxScala
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxScala : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("scala"),
            };
        }

        public DoxScala(sTitle) {
            base("DoxScala", sTitle, "!", "!", "@", Dox.SYNTAX.SCALA,
                DoxScala.createMimeTypes(sTitle));
        }
    }
}
