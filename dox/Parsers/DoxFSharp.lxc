--[[!
@fqxn Dox.DoxFSharp
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxFSharp : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("fs"),
            };
        }

        public DoxFSharp(sTitle) {
            base("DoxFSharp", sTitle, "!", "!", "@", Dox.SYNTAX.F_SHARP,
                DoxFSharp.createMimeTypes(sTitle));
        }
    }
}
