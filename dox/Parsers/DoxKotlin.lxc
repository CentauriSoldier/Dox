--[[!
@fqxn Dox.DoxKotlin
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxKotlin : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("kt"),
            };
        }

        public DoxKotlin(sTitle) {
            base("DoxKotlin", sTitle, "!", "!", "@", Dox.SYNTAX.KOTLIN,
                DoxKotlin.createMimeTypes(sTitle));
        }
    }
}
