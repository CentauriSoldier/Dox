--[[!
@fqxn Dox.DoxSwift
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxSwift : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("swift"),
            };
        }

        public DoxSwift(sTitle) {
            base("DoxSwift", sTitle, "!", "!", "@", Dox.SYNTAX.SWIFT,
                DoxSwift.createMimeTypes(sTitle));
        }
    }
}
