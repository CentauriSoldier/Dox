--[[!
@fqxn Dox.DoxDart
@desc Language-specific documentation parser retaining its syntax, MIME types and delimiters.
!]]
namespace Dox {
    final class DoxDart : Dox.Parser requires(Dox.DoxMime, Dox.SYNTAX) {
        private static createMimeTypes(sTitle) {
            type.assert.string(sTitle, "%S+", "Dox Parser title name must not be blank.");
            return {
                Dox.DoxMime("dart"),
            };
        }

        public DoxDart(sTitle) {
            base("DoxDart", sTitle, "!", "!", "@", Dox.SYNTAX.DART,
                DoxDart.createMimeTypes(sTitle));
        }
    }
}
