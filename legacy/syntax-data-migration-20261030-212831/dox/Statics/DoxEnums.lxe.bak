        DRACULA = "dracula";
        GRUVBOX_DARK = "gruvbox_dark";
        GRUVBOX_LIGHT = "gruvbox_light";
        MIDNIGHT_BLUE = "midnight_blue";
        NORD = "nord";
        ROSE_PINE = "rose_pine";
